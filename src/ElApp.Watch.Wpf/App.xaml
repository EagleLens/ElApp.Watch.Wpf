<Application x:Class="ElApp.Watch.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElApp.Watch.Wpf"
             ShutdownMode="OnMainWindowClose">
    <!-- No StartupUri: App.xaml.cs's OnStartup builds the host, resolves MainWindow and its
         MainViewModel through DI, and shows it explicitly. -->
    <Application.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#171A21"/>
        <SolidColorBrush x:Key="TileBrush" Color="#1B1F29"/>
        <SolidColorBrush x:Key="BorderBrush1" Color="#262B36"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#22D3EE"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B93A7"/>
        <SolidColorBrush x:Key="OnlineBrush" Color="#34D399"/>
        <SolidColorBrush x:Key="OfflineBrush" Color="#F87171"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#FBBF24"/>

        <!-- Camera entry in the sidebar list -->
        <Style x:Key="CameraListItem" TargetType="Border">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F2430"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small icon-style button used in the top bar -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F2430"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
