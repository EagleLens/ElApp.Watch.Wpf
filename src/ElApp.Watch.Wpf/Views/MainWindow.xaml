<Window x:Class="ElApp.Watch.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElApp.Watch.Wpf.Views"
        xmlns:vm="clr-namespace:ElApp.Watch.Wpf.ViewModels"
        xmlns:conv="clr-namespace:ElApp.Watch.Wpf.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="CCTV Monitor" Height="750" Width="1200" MinHeight="550" MinWidth="900"
        Background="#0F1115"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <conv:ShowLabelsToOpacityConverter x:Key="ShowLabelsToOpacity"/>
        <conv:ShowLabelsToTextDecorationsConverter x:Key="ShowLabelsToTextDecorations"/>

        <!-- Sidebar camera-list entry -->
        <DataTemplate x:Key="SidebarItemTemplate" DataType="{x:Type vm:PumpTileViewModel}">
            <Border Style="{StaticResource CameraListItem}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding SidebarDotBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ===================== TOP BAR ===================== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="CCTV MONITOR" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="v1.0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,4,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#16261F" CornerRadius="12" Padding="10,4" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="OnlineCountDot" Width="8" Height="8" Fill="{Binding OnlineCountBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="OnlineCountText" Text="{Binding OnlineCountText}" Foreground="{StaticResource OnlineBrush}" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ClockText" Text="{Binding ClockText}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Button x:Name="ToggleLabelsButton" Style="{StaticResource IconButton}"
                            ToolTip="Show/hide status labels (icons stay visible)"
                            Command="{Binding ToggleLabelsCommand}"
                            Opacity="{Binding ShowStatusLabels, Converter={StaticResource ShowLabelsToOpacity}}">
                        <TextBlock x:Name="ToggleLabelsButtonText" Text="Aa" FontSize="12" FontWeight="Bold"
                                   TextDecorations="{Binding ShowStatusLabels, Converter={StaticResource ShowLabelsToTextDecorations}}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#9881;" ToolTip="Settings"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== MAIN CONTENT ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CAMERAS" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" FontWeight="Bold" Margin="16,16,16,8"/>

                    <ItemsControl x:Name="CameraListPanel" DockPanel.Dock="Top"
                                  ItemsSource="{Binding Tiles}"
                                  ItemTemplate="{StaticResource SidebarItemTemplate}"/>

                    <Border DockPanel.Dock="Bottom" Margin="12,0,12,16" Padding="12" CornerRadius="8" Background="#1B1F29">
                        <StackPanel>
                            <TextBlock Text="Storage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6"/>
                            <Border Height="6" CornerRadius="3" Background="#2A2F3B">
                                <Border HorizontalAlignment="Left" Width="90" Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="62% used &#183; 1.2 TB free" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid/>
                </DockPanel>
            </Border>

            <!-- Camera Grid -->
            <Border Grid.Column="1" Background="#0F1115">
                <ItemsControl x:Name="CameraGrid" Margin="16" ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding GridRows}" Columns="{Binding GridColumns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PumpTileViewModel}">
                            <local:PumpTileView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- ===================== STATUS BAR ===================== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock Text="Ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="Recording to local storage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

    </Grid>
</Window>
