<Window x:Class="ElApp.Watch.Wpf.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EagleLens" Width="440" Height="280"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="#0F1115" BorderBrush="#262B36" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="36" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================== MARK + WORDMARK ===================== -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Lens mark: a ring with an aperture dot, echoing a camera lens / eagle eye -->
                <Grid Width="60" Height="60" Margin="0,0,0,20">
                    <Ellipse Stroke="#22D3EE" StrokeThickness="3" Width="60" Height="60"/>
                    <Ellipse Fill="#22D3EE" Width="12" Height="12"/>
                    <Ellipse Stroke="#1F2430" StrokeThickness="1" Width="40" Height="40"/>
                </Grid>

                <TextBlock FontSize="30" FontWeight="Bold" HorizontalAlignment="Center">
                    <Run Text="Eagle" Foreground="#E5E7EB"/><Run Text="Lens" Foreground="#22D3EE"/>
                </TextBlock>

                <TextBlock Text="FORECOURT WATCH" Foreground="#8B93A7" FontSize="11" FontWeight="Medium"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- ===================== PROGRESS + STATUS ===================== -->
            <StackPanel Grid.Row="1" Margin="56,0,56,28">
                <Border x:Name="ProgressTrack" Height="3" CornerRadius="1.5" Background="#1F2430" ClipToBounds="True">
                    <Border x:Name="ProgressHighlight" Height="3" Width="70" CornerRadius="1.5" Background="#22D3EE" HorizontalAlignment="Left">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ProgressTransform" X="-70"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock x:Name="StatusText" Text="Starting..." Foreground="#8B93A7" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
