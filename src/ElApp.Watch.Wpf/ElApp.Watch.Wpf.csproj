<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ElApp.Watch.Wpf</AssemblyName>
    <RootNamespace>ElApp.Watch.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElApp.Watch.Vision\ElApp.Watch.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.WpfExtensions" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.jpg" />
    <Resource Include="Assets\*.png" />
    <Content Include="Assets\*.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Models\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
